<?xml version="1.0" encoding="utf-8"?>
<!-- La ventana nace del color del papel de la página: así no se ve negro mientras arranca -->
<resources>
    <style name="Tema" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/portada</item>
        <item name="android:statusBarColor">@color/papel</item>
        <item name="android:navigationBarColor">@color/papel</item>
    </style>
    <color name="papel">#FFEFE8DA</color>
    <color name="violeta">#FF6D28D9</color>
</resources>
